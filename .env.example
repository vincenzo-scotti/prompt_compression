# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# HuggingFace Hub (required for gated models like Mistral, Llama)
HF_TOKEN=

# OpenAI API (required when --model-type openai)
OPENAI_API_KEY=

# Gemini API
GEMINI_API_KEY=

# llama.cpp / llama-swap server (model type "llama-cpp").
# Server root URL (the API path /v1/chat/completions is added automatically);
# a model.kwargs.base_url in the YAML config takes precedence.  Unset → localhost:8080.
LLAMA_CPP_BASE_URL=
LLAMA_CPP_API_KEY=

# Weights & Biases (optional, for experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=prompt_piper

# Proxy / custom HuggingFace endpoint (optional)
# HF_ENDPOINT=https://huggingface.co